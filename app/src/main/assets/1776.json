          {
            "start": 0,
            "end": 2.6,
            "en": "I’ve been reading Common Sense by Thomas Paine",
            "zh": "我一直在读托马斯·潘恩的《常识》"
          },
          {
            "start": 2.6,
            "end": 4.95,
            "en": "So men say that I’m intense or I’m insane",
            "zh": "于是男人们说我太激进，或是疯了"
          },
          {
            "start": 4.95,
            "end": 6.15,
            "en": "You want a revolution?",
            "zh": "你想要一场革命？"
          },
          {
            "start": 6.15,
            "end": 7.35,
            "en": "I want a revelation",
            "zh": "我要的是思想的觉醒"
          },
          {
            "start": 7.35,
            "end": 9.65,
            "en": "So listen to my declaration:",
            "zh": "那就听听我的宣言："
          },
          {
            "start": 9.65,
            "end": 12,
            "en": "We hold these truths to be self-evident",
            "zh": "我们认为这些真理不言而喻"
          },
          {
            "start": 12,
            "end": 14.35,
            "en": "That all men are created equal",
            "zh": "人人生而平等"
          },
          {
            "start": 14.35,
            "end": 16.7,
            "en": "And when I meet Thomas Jefferson (unh!)",
            "zh": "等我见到托马斯·杰斐逊——哼！"
          },
          {
            "start": 16.7,
            "end": 19.45,
            "en": "I’mma compel him to include women in the sequel!",
            "zh": "我要让他在续篇中把女性也写进去！"
          },
          {
            "start": 19.45,
            "end": 19.9,
            "en": "Work!",
            "zh": "行动起来！"
          }
        ]
      }
